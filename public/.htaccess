# ==========================================================
# Veterinární klinika Hloubětín – konfigurace Apache (WEDOS)
# ==========================================================

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS + bez www. Doména musí odpovídat PUBLIC_SITE_URL (astro.config.mjs).
  # Testovací adresa musí běžet na HTTPS, jinak ji toto pravidlo přesměruje na ostrý web.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://veterinahloubetin.cz%{REQUEST_URI} [L,R=301]

  # Konfigurace formuláře není veřejná
  RewriteRule ^odeslat\.config\.php$ - [F,L]

  # ---------- Přesměrování starých WordPress adres ----------
  # Duplicitní stránky ze starého webu (zobrazovaly obsah rezervací)
  RewriteRule ^sluzby/?$ /#sluzby [NE,L,R=301]
  RewriteRule ^o-nas/?$ /#onas [NE,L,R=301]
  # Zkrácený odkaz z patičky starého webu
  RewriteRule ^cenik/?$ /cenik-zakroku-a-vysetreni/ [L,R=301]
  # Kategorie, stránkování, autoři a RSS z WordPressu
  RewriteRule ^(category|author)/ /clanky/ [L,R=301]
  RewriteRule ^clanky/page/ /clanky/ [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ /clanky/ [L,R=301]
  RewriteRule ^[^/]+/feed/?$ /clanky/ [L,R=301]
  # Sitemapy z pluginu Yoast
  RewriteRule ^(sitemap_index|wp-sitemap|post-sitemap|page-sitemap|category-sitemap)\.xml$ /sitemap-index.xml [L,R=301]
  # Administrace WordPressu už neexistuje
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [G,L]

  # Lomítko na konci URL (stejně jako na původním WordPressu)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-z0-9]{2,5}$ [NC]
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# ---------- Bezpečnostní hlavičky ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP zatím jen hlásí porušení do konzole prohlížeče, nic neblokuje. Ostrou hlavičku (bez -Report-Only)
  # zapnout až po týdnu v provozu bez hlášení. Nová služba v GTM = doplnit její domény sem.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; \
    script-src 'self' 'unsafe-inline' https://cdn-cookieyes.com https://*.googletagmanager.com https://booking.reservanto.cz https://c.seznam.cz https://www.google.com https://www.googleadservices.com https://googleads.g.doubleclick.net; \
    style-src 'self' 'unsafe-inline' https://cdn-cookieyes.com; \
    img-src 'self' data: https://www.firmy.cz https://cdn-cookieyes.com https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://c.seznam.cz https://www.google.com https://www.google.cz https://googleads.g.doubleclick.net; \
    font-src 'self'; \
    connect-src 'self' https://cdn-cookieyes.com https://log.cookieyes.com https://*.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://c.seznam.cz https://www.google.com; \
    frame-src https://booking.reservanto.cz https://www.google.com https://www.googletagmanager.com; \
    object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # Soubory bez otisku v názvu (logo, ikony, PDF) se můžou změnit – cache na den
  <FilesMatch "\.(css|js|webp|avif|jpg|jpeg|png|svg|woff2?|pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  # Soubory z buildu mají v názvu otisk (nazev.AbCd1234.js, nazev.AbCd1234_x.webp) – nemění se, cache na rok
  <FilesMatch "\.[A-Za-z0-9_-]{8}(_[A-Za-z0-9_-]+)?\.(css|js|webp|avif|jpg|jpeg|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
