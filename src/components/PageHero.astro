---
import { getImage } from 'astro:assets';

// Záhlaví podstránek – tmavá fotka psa s nadpisem
interface Props {
  title: string;
  subtitle?: string;
  image: ImageMetadata;
  position?: string;
  /** Nadpis stránky je H1 jen tam, kde stránka nemá vlastní H1 v obsahu */
  as?: 'h1' | 'p';
}

const { title, subtitle, image, position = 'center', as: Tag = 'h1' } = Astro.props;
const bg = await getImage({ src: image, width: 1920, format: 'webp', quality: 70 });
const bgSmall = await getImage({ src: image, width: 960, format: 'webp', quality: 70 });
---

<section
  class="page-hero"
  style={`--hero-bg:url(${bg.src});--hero-bg-sm:url(${bgSmall.src});--hero-pos:${position}`}
>
  <div class="row">
    <Tag class="page-hero__title">{title}</Tag>
    {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding: 24px 0 51px;
    background-color: #5c5148;
    background-image: linear-gradient(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.18)), var(--hero-bg);
    background-position: var(--hero-pos);
    background-size: cover;
    color: var(--c-white);
    text-align: center;
  }

  .page-hero .row {
    padding: 27px 0;
  }

  .page-hero__title {
    margin: 35px 0 0;
    padding: 0;
    color: var(--c-white);
    font-family: var(--f-head);
    font-size: 38px;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1.2em;
    text-shadow: 0 0 1em rgba(0, 0, 0, 0.25);
  }

  .page-hero__subtitle {
    margin-top: 6px;
    padding: 0;
    color: var(--c-white);
    font-family: var(--f-head);
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 2px;
  }

  @media (max-width: 980px) {
    .page-hero {
      padding: 22px 0 40px;
    }
    .page-hero__title {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .page-hero {
      padding: 7px 0 5px;
      background-image: linear-gradient(rgba(0, 0, 0, 0.22), rgba(0, 0, 0, 0.22)), var(--hero-bg-sm);
    }
    .page-hero__title {
      margin: 10px 0 8px;
      font-size: 34px;
    }
    .page-hero__subtitle {
      margin-bottom: 16px;
      font-size: 18px;
    }
  }
</style>
