---
import Breadcrumbs from './Breadcrumbs.astro';

// Světlé záhlaví podstránek (stejný styl jako u článků): drobečková navigace, nadpis, podnadpis
interface Props {
  title: string;
  subtitle?: string;
  lead?: string;
  /** Položky drobečkové navigace za „Úvod“ */
  crumbs: { label: string; href?: string }[];
}

const { title, subtitle, lead, crumbs } = Astro.props;
---

<section class="page-hero">
  <div class="row page-hero__row">
    <div class="page-hero__text">
      <Breadcrumbs items={crumbs} class="page-hero__crumbs" />
      <h1 class="page-hero__title">{title}</h1>
      {subtitle && <p class="page-hero__subtitle">{subtitle}</p>}
      {lead && <p class="page-hero__lead">{lead}</p>}
    </div>
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--c-cream) 0%, #fff 100%);
  }

  .page-hero__row {
    padding: 26px 0 22px;
  }

  .page-hero__text {
    min-width: 0;
  }

  .page-hero :global(.page-hero__crumbs) {
    margin-bottom: 18px;
  }

  .page-hero :global(.page-hero__crumbs a:not(:hover)) {
    background: var(--c-white);
  }

  .page-hero__title {
    padding: 0;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15;
  }

  .page-hero__subtitle {
    margin-top: 6px;
    padding: 0;
    color: var(--c-orange-deep);
    font-family: var(--f-head);
    font-size: 19px;
    font-weight: 800;
  }

  .page-hero__lead {
    max-width: 620px;
    margin-top: 8px;
    padding: 0;
    color: var(--c-text);
    font-family: var(--f-head);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .page-hero__row {
      padding: 18px 0 10px;
    }
    .page-hero :global(.page-hero__crumbs) {
      margin-bottom: 12px;
    }
    .page-hero__title {
      font-size: 30px;
    }
    .page-hero__subtitle {
      font-size: 17px;
    }
    .page-hero__lead {
      font-size: 15px;
    }
  }
</style>
