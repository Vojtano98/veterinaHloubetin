---
import allReviews from '../data/reviews.json';

// Zobrazujeme jen recenze se 4 a více hvězdičkami (datum ve formátu DD/MM/RRRR).
// Pořadí: vyšší hodnocení, pak výstižné recenze (aspoň pár vět) před jednoslovnými, pak nejnovější.
const toTime = (d: string) => {
  const [day, month, year] = d.split('/').map(Number);
  return new Date(year, month - 1, day).getTime();
};
const detailed = (t: string) => (t.length >= 80 ? 1 : 0);
const reviews = allReviews
  .filter((r) => r.rating >= 4)
  .sort((a, b) => b.rating - a.rating || detailed(b.text) - detailed(a.text) || toTime(b.date) - toTime(a.date));

// Recenze z Google. Soubor src/data/reviews.json jednou týdně přepíše scripts/update-google-reviews.mjs
// (GitHub Actions), ručně ho lze upravit také.
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
const palette = ['#f99420', '#316eff', '#2bb3a3', '#a35ad6', '#e0574f', '#4c9a2a'];
---

<div class="reviews" data-reviews>
  <button class="reviews__nav reviews__nav--prev" type="button" aria-label="Předchozí recenze" data-prev>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
  <ul class="reviews__track" data-track aria-label="Recenze klientů z Google">
    {
      reviews.map((r, i) => (
        <li class="review">
          <article class="review__card">
            <header class="review__head">
              <span class="review__avatar" style={`background:${palette[i % palette.length]}`} aria-hidden="true">
                {initials(r.name)}
              </span>
              <span class="review__who">
                {'url' in r && r.url ? (
                  <a class="review__name" href={r.url} target="_blank" rel="noopener nofollow">
                    {r.name}
                  </a>
                ) : (
                  <span class="review__name">{r.name}</span>
                )}
                <span class="review__date">{r.date}</span>
              </span>
              <svg class="review__g" viewBox="0 0 48 48" width="20" height="20" aria-label="Google">
                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
                <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
              </svg>
            </header>
            <div class="review__stars" role="img" aria-label={`Hodnocení ${r.rating} z 5`}>
              {'★★★★★'.slice(0, r.rating)}
            </div>
            <p class="review__text" data-text>{r.text}</p>
            <button class="review__more" type="button" data-more hidden>
              Přečtěte si více
            </button>
          </article>
        </li>
      ))
    }
  </ul>
  <button class="reviews__nav reviews__nav--next" type="button" aria-label="Další recenze" data-next>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </button>
</div>

<style>
  .reviews {
    position: relative;
    padding: 0 34px;
  }

  .reviews__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * 20px) / 3);
    gap: 20px;
    margin: 0;
    padding: 10px 4px 24px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .reviews__track::-webkit-scrollbar {
    display: none;
  }

  .review {
    scroll-snap-align: start;
  }

  .review__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 18px 20px 16px;
    border: 1px solid #f0e8e0;
    border-radius: 16px;
    background: var(--c-white);
    box-shadow: 0 10px 26px -18px rgba(0, 0, 0, 0.35);
    font-family: var(--f-head);
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .review__avatar {
    display: grid;
    place-items: center;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
  }

  .review__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.3;
  }

  .review__name {
    overflow: hidden;
    color: #111;
    font-size: 15px;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a.review__name:hover {
    opacity: 1;
    color: var(--c-orange-deep);
  }

  .review__date {
    color: #888;
    font-size: 12px;
  }

  .review__g {
    margin-left: auto;
    flex: 0 0 auto;
  }

  .review__stars {
    margin: 10px 0 6px;
    color: #f6bb06;
    font-size: 19px;
    letter-spacing: 2px;
    line-height: 1;
    text-align: center;
  }

  .review__text {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* Pojistka proti useknutému šestému řádku (5 × výška řádku) */
    max-height: calc(5 * 1.55em);
    color: #222;
    font-size: 14px;
    line-height: 1.55;
    text-align: center;
  }

  .review__text.is-open {
    display: block;
    max-height: none;
  }

  .review__more {
    align-self: center;
    margin-top: auto;
    padding: 10px 6px 0;
    border: 0;
    background: none;
    color: var(--c-link);
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .review__more:hover {
    color: var(--c-orange-deep);
  }

  .reviews__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-top: -22px;
    padding: 0;
    border: 1px solid #ccc;
    border-radius: 50%;
    background: var(--c-white);
    color: #555;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease;
  }

  .reviews__nav:hover {
    background: var(--c-orange);
    border-color: var(--c-orange);
    color: #fff;
  }

  .reviews__nav--prev {
    left: 0;
  }

  .reviews__nav--next {
    right: 0;
  }

  @media (max-width: 980px) {
    .reviews__track {
      grid-auto-columns: calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 767px) {
    .reviews {
      padding: 0;
    }
    .reviews__track {
      grid-auto-columns: 86%;
      gap: 14px;
    }
    .reviews__nav {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const step = () => (track.firstElementChild as HTMLElement).getBoundingClientRect().width + 20;
    root.querySelector('[data-prev]')?.addEventListener('click', () => {
      const atStart = track.scrollLeft <= 4;
      track.scrollBy({ left: atStart ? track.scrollWidth : -step(), behavior: 'smooth' });
    });
    root.querySelector('[data-next]')?.addEventListener('click', () => {
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      track.scrollBy({ left: atEnd ? -track.scrollWidth : step(), behavior: 'smooth' });
    });

    root.querySelectorAll<HTMLElement>('.review__card').forEach((card) => {
      const text = card.querySelector<HTMLElement>('[data-text]')!;
      const more = card.querySelector<HTMLButtonElement>('[data-more]')!;
      if (text.scrollHeight > text.clientHeight + 2) more.hidden = false;
      more.addEventListener('click', () => {
        const open = text.classList.toggle('is-open');
        more.textContent = open ? 'Skrýt' : 'Přečtěte si více';
      });
    });
  });
</script>
