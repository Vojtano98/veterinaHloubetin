---
import { Image } from 'astro:assets';
import Wave from './Wave.astro';
import Icon from './Icon.astro';
import { services } from '../data/services';
import { site } from '../data/site';
import vetIllustration from '../assets/uploads/2024/05/vet-06.png';
---

<section class="svc" id="sluzby" aria-labelledby="sluzby-title">
  <Wave variant="arch" position="top" color="#FFFFFF" height="20vw" />

  <div class="row svc__intro">
    <div class="svc__intro-text">
      <p class="eyebrow">Naše služby</p>
      <h2 id="sluzby-title" class="svc__title">
        Vše pro zdraví vašeho mazlíčka pod jednou střechou
      </h2>
      <p class="svc__lead">
        Od prevence a očkování přes interní medicínu až po chirurgii, stomatologii a péči o exotická zvířata.
      </p>
      <div class="svc__actions">
        <a class="btn" href="/rezervace-sluzeb/">Objednat se online</a>
        <a class="svc__link" href="/cenik-zakroku-a-vysetreni/">Zobrazit ceník <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <div class="svc__illu" aria-hidden="true">
      <Image src={vetIllustration} alt="" width={420} loading="lazy" />
    </div>
  </div>

  <div class="row row--wide svc__body" id="sluzby-podrobne">
    <ul class="svc__grid" data-svc-track>
      {
        services.map((s) => (
          <li class="svc-card" id={s.id}>
            <div class="svc-card__head">
              <span class="svc-card__img">
                <Image src={s.image} alt="" width={144} height={144} loading="lazy" />
              </span>
              <h3 class="svc-card__title">{s.title}</h3>
            </div>
            <ul class="svc-card__list">
              {s.items.map((it) => (
                <li>
                  <Icon name="check" size={16} class="svc-card__check" />
                  <span>{it}</span>
                </li>
              ))}
            </ul>
            {s.articles && (
              <div class="svc-card__read">
                <p class="svc-card__read-label">Přečtěte si</p>
                <ul>
                  {s.articles.map((a) => (
                    <li>
                      <a href={`/${a.slug}/`}>{a.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>
    <p class="svc__swipe" aria-hidden="true">Posuňte do strany pro další služby →</p>

    <div class="svc-cta">
      <div class="svc-cta__text">
        <p class="svc-cta__title">Nenašli jste, co hledáte?</p>
        <p>Zavolejte nám a domluvíme se – objednáme vás ke konkrétnímu lékaři podle potíží vašeho mazlíčka.</p>
      </div>
      <div class="svc-cta__actions">
        <a class="svc-cta__phone" href={site.phones.main.href}>
          <Icon name="phone" size={18} />
          {site.phones.main.label}
        </a>
        <a class="btn" href="/rezervace-sluzeb/">Online rezervace</a>
      </div>
    </div>
  </div>
</section>

<style>
  .svc {
    position: relative;
    margin-top: -16px;
    padding: 3vw 0 60px;
    background-color: var(--c-cream);
    background-image: linear-gradient(180deg, #fff6ef 0%, #fffaf6 70%, #ffffff 100%);
    scroll-margin-top: 80px;
  }

  /* ---------- Úvod ---------- */
  .svc__intro {
    z-index: 2;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: end;
    gap: 40px;
    padding-bottom: 0;
  }

  .svc__title {
    padding-bottom: 14px;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 36px;
    font-weight: 800;
    line-height: 1.15em;
  }

  .svc__lead {
    max-width: 560px;
    padding-bottom: 22px;
    color: var(--c-text);
    font-family: var(--f-head);
    font-size: 18px;
    line-height: 1.6;
  }

  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    padding-bottom: 30px;
  }

  .svc__link {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--c-black);
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .svc__link:hover {
    opacity: 1;
    color: var(--c-orange-deep);
  }

  .svc__illu {
    display: flex;
    justify-content: center;
  }

  .svc__illu :global(img) {
    width: 70%;
    max-width: 330px;
    margin-bottom: -6px;
  }

  /* ---------- Karty služeb ---------- */
  .svc__body {
    z-index: 2;
    padding-top: 0;
  }

  .svc__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px 22px 22px;
    border: 1px solid #f2e6da;
    border-radius: 18px;
    background: var(--c-white);
    box-shadow: 0 10px 30px -18px rgba(120, 72, 20, 0.35);
    transition:
      transform 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
    scroll-margin-top: 100px;
  }

  .svc-card::before {
    content: '';
    position: absolute;
    left: 22px;
    right: 22px;
    top: 0;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--c-orange);
    transform: scaleX(0.25);
    transform-origin: left;
    transition: transform 300ms ease;
  }

  .svc-card:hover {
    transform: translateY(-4px);
    border-color: #f6cfa5;
    box-shadow: 0 18px 36px -18px rgba(120, 72, 20, 0.45);
  }

  .svc-card:hover::before {
    transform: scaleX(1);
  }

  .svc-card__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }

  .svc-card__img {
    display: block;
    flex: none;
    width: 60px;
    height: 60px;
    padding: 3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #ffd9b0, #fff1e4);
  }

  .svc-card__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
  }

  .svc-card__title {
    padding: 0;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
  }

  .svc-card__list {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.45;
    color: #555;
  }

  .svc-card__list li {
    display: flex;
    gap: 8px;
  }

  .svc-card__list :global(.svc-card__check) {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--c-orange);
  }

  .svc-card__read {
    margin-top: auto;
    padding-top: 16px;
  }

  .svc-card__read-label {
    padding: 14px 0 6px;
    border-top: 1px solid #f2e6da;
    color: #8a7a6c;
    font-family: var(--f-head);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .svc-card__read ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-card__read a {
    display: inline-block;
    padding: 4px 11px;
    border-radius: 100px;
    background: var(--c-cream);
    color: var(--c-link);
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 800;
    transition: background 200ms ease, color 200ms ease;
  }

  .svc-card__read a:hover {
    opacity: 1;
    background: var(--c-orange);
    color: var(--c-white);
  }

  .svc__swipe {
    display: none;
  }

  /* ---------- Výzva pod kartami ---------- */
  .svc-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 30px;
    margin-top: 28px;
    padding: 26px 32px;
    border-radius: 18px;
    background: linear-gradient(110deg, #3a2a1c 0%, #5a3e26 100%);
    color: #f6ece2;
    font-family: var(--f-head);
  }

  .svc-cta__text {
    flex: 1 1 380px;
    font-size: 16px;
    line-height: 1.6;
  }

  .svc-cta__title {
    padding-bottom: 4px;
    color: var(--c-white);
    font-size: 22px;
    font-weight: 800;
  }

  .svc-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
  }

  .svc-cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 100px;
    color: var(--c-white);
    font-size: 16px;
    font-weight: 800;
    transition: background 200ms ease;
  }

  .svc-cta__phone:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.1);
  }

  /* ---------- Responzivita ---------- */
  @media (max-width: 1100px) {
    .svc__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 980px) {
    .svc {
      padding-top: 7vw;
      margin-top: 10px;
    }
    .svc__intro {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .svc__illu {
      display: none;
    }
    .svc__title {
      font-size: 32px;
    }
  }

  @media (max-width: 767px) {
    .svc {
      padding-top: 17vw;
      padding-bottom: 40px;
    }
    .svc__title {
      font-size: 26px;
    }
    .svc__lead {
      font-size: 16px;
    }

    /* Na mobilu vodorovný posuvný pás karet */
    .svc__body {
      width: 100%;
    }
    .svc__grid {
      display: flex;
      gap: 14px;
      padding: 6px 16px 18px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 16px;
      scrollbar-width: none;
    }
    .svc__grid::-webkit-scrollbar {
      display: none;
    }
    .svc-card {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
    .svc-card:hover {
      transform: none;
    }
    .svc__swipe {
      display: block;
      margin: 0 16px;
      color: #a08a76;
      font-family: var(--f-head);
      font-size: 13px;
      font-weight: 700;
      text-align: right;
    }
    .svc-cta {
      margin: 22px 16px 0;
      padding: 22px 20px;
    }
    .svc-cta__actions {
      width: 100%;
    }
    .svc-cta__actions > * {
      flex: 1 1 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
