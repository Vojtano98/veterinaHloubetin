---
import { site } from '../data/site';
import Icon from './Icon.astro';

// Kompaktní pruh s adresou, telefonem a otevírací dobou (úvod + konec článků).
// Na počítači tři sloupce s oddělovači: text v každém sloupci plyne přirozeně, jen tlačítka jsou dole v jedné linii.
interface Props {
  title: string;
  subtitle?: string;
  class?: string;
  /** „stacked“ = viditelný nadpis s podnadpisem nad sloupci (pod články); jinak je nadpis jen pro čtečky */
  layout?: 'row' | 'stacked';
}

const { title, subtitle, class: className, layout = 'row' } = Astro.props;
---

<div class:list={['info-box', `info-box--${layout}`, className]}>
  <div class:list={['info-box__intro', { 'sr-only': layout === 'row' }]}>
    <h2 class="info-box__title">{title}</h2>
    {subtitle && <p class="info-box__subtitle">{subtitle}</p>}
  </div>

  <div class="ib-item">
    <span class="ib-icon"><Icon name="pin" size={18} /></span>
    <p class="ib-label">Adresa</p>
    <p class="ib-value">{site.address.street}<br /><span class="nowrap">{site.address.zip} {site.address.city}</span></p>
    <p class="ib-meta">U metra Hloubětín</p>
    <a class="ib-action" href={site.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={14} /> Navigovat</a>
  </div>

  <div class="ib-item">
    <span class="ib-icon"><Icon name="phone" size={18} /></span>
    <p class="ib-label">Telefon</p>
    <p class="ib-value nowrap">{site.phones.main.label}</p>
    <p class="ib-meta">Ordinace i pohotovost</p>
    <a class="ib-action" href={site.phones.main.href}><Icon name="phone" size={14} /> Zavolat</a>
  </div>

  <div class="ib-item">
    <span class="ib-icon"><Icon name="clock" size={18} /></span>
    <p class="ib-label">Ordinační hodiny</p>
    <dl class="ib-value ib-hours">
      {
        site.hours.map((h) => (
          <div>
            <dt>{h.short}</dt>
            <dd>{h.time}</dd>
          </div>
        ))
      }
    </dl>
    <a class="ib-action" href="/rezervace-sluzeb/"><Icon name="calendar" size={14} /> Objednat se</a>
  </div>
</div>

<style>
  .info-box {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 20px 8px;
    border-radius: 18px;
    background: var(--c-white);
    box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.4);
    font-family: var(--f-head);
  }

  .info-box__title {
    padding: 0;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 26px;
    font-weight: 800;
    line-height: 1.25;
  }

  .info-box__subtitle {
    margin-top: 6px;
    color: var(--c-text);
    font-size: 16px;
    line-height: 1.5;
  }

  /* Sloupec: ikona vlevo, vpravo popisek, údaj, doplněk a pod nimi tlačítko */
  .ib-item {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    grid-template-rows: auto auto auto 1fr;
    column-gap: 12px;
    row-gap: 3px;
    padding: 0 18px;
  }

  .ib-item + .ib-item {
    border-left: 1px solid #efe6dd;
  }

  .ib-icon {
    display: grid;
    grid-column: 1;
    grid-row: 1 / span 2;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-cream);
    color: var(--c-orange-deep);
  }

  .ib-label,
  .ib-value,
  .ib-meta {
    grid-column: 2;
    margin: 0;
    padding: 0;
  }

  .ib-label {
    color: var(--c-accent-text);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ib-value {
    color: var(--c-ink);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.4;
  }

  /* Ordinační hodiny pod sebou: den a čas ve dvou sloupcích */
  .ib-hours div {
    display: grid;
    grid-template-columns: 60px auto;
  }

  .ib-hours dt {
    color: var(--c-label);
    font-weight: 700;
  }

  .ib-hours dd {
    margin: 0;
    white-space: nowrap;
  }

  .ib-meta {
    color: var(--c-label);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .ib-action {
    display: inline-flex;
    grid-column: 2;
    grid-row: 4;
    align-self: end;
    justify-self: start;
    align-items: center;
    margin-top: 12px;
    gap: 6px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 100px;
    background: var(--c-cta);
    color: var(--c-on-cta);
    font-size: 13px;
    font-weight: 800;
    white-space: nowrap;
    transition: background 200ms ease;
  }

  .ib-action:hover {
    opacity: 1;
    background: var(--c-cta-hover);
  }

  /* Pod články: viditelný nadpis uprostřed nad sloupci */
  .info-box--stacked {
    padding: 28px 8px 24px;
    border: 1px solid #f2e8de;
  }

  .info-box--stacked .info-box__intro {
    grid-column: 1 / -1;
    padding: 0 18px 20px;
    text-align: center;
  }

  /* Užší počítače: bez ikon a o kousek menší údaj, ať se každý údaj vejde na jeden řádek */
  @media (min-width: 981px) and (max-width: 1279px) {
    .ib-item {
      grid-template-columns: minmax(0, 1fr);
    }
    .ib-icon {
      display: none;
    }
    .ib-label,
    .ib-value,
    .ib-meta,
    .ib-action {
      grid-column: 1;
    }
    .ib-value {
      font-size: 14px;
    }
  }

  /* Tablety a telefony: řádky pod sebou, tlačítko vpravo */
  @media (max-width: 980px) {
    .info-box,
    .info-box--stacked {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      padding: 6px 4px;
    }
    .info-box--stacked {
      padding-top: 22px;
    }
    .info-box--stacked .info-box__intro {
      padding-bottom: 10px;
    }
    .ib-item {
      grid-template-columns: 36px minmax(0, 1fr) auto;
      grid-template-rows: auto auto auto;
      grid-row: auto;
      padding: 14px 14px;
    }
    .ib-action {
      grid-column: 3;
      grid-row: 1 / -1;
      align-self: center;
      margin-top: 0;
    }
    .ib-item + .ib-item {
      border-top: 1px solid #efe6dd;
      border-left: 0;
    }
  }

  @media (max-width: 767px) {
    .info-box {
      border-radius: 16px;
    }
    .info-box__title {
      font-size: 20px;
    }
    .info-box__subtitle {
      font-size: 14px;
    }
    .ib-value {
      font-size: 15px;
    }
  }

  /* Telefony: tlačítko pod textem, vedle by se údaje lámaly */
  @media (max-width: 599px) {
    .ib-item {
      grid-template-columns: 36px minmax(0, 1fr);
      grid-template-rows: auto auto auto auto;
    }
    .ib-action {
      grid-column: 2;
      grid-row: 4;
      justify-self: start;
      margin-top: 8px;
    }
  }
</style>
