---
// Kontaktní formulář – odesílá na /odeslat.php (PHP na hostingu WEDOS).
// Funguje i bez JavaScriptu (klasické odeslání + přesměrování zpět). Na náhledu (GitHub Pages) PHP neběží,
// proto se tam formulář jen zkontroluje a neodesílá.
import { isPreview } from '../lib/indexing';

const { source = 'kontakty' } = Astro.props as { source?: string };
const id = (name: string) => `${source}-${name}-chyba`;
---

<form class="cform" action="/odeslat.php" method="post" novalidate data-cform data-preview={isPreview ? '1' : undefined}>
  <input type="hidden" name="zdroj" value={source} />
  <input type="hidden" name="ts" value="" data-ts />
  <div class="cform__hp" aria-hidden="true">
    <label>Nevyplňujte <input type="text" name="web" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="cform__grid">
    <label class="field">
      <span class="field__label">Jméno a příjmení <abbr title="povinné">*</abbr></span>
      <input type="text" name="jmeno" required maxlength="120" autocomplete="name" aria-describedby={id('jmeno')} />
      <span class="field__error" id={id('jmeno')} data-error></span>
    </label>
    <label class="field">
      <span class="field__label">Telefon</span>
      <input type="tel" name="telefon" maxlength="40" autocomplete="tel" inputmode="tel" aria-describedby={id('telefon')} />
      <span class="field__error" id={id('telefon')} data-error></span>
    </label>
    <label class="field">
      <span class="field__label">E-mail <abbr title="povinné">*</abbr></span>
      <input type="email" name="email" required maxlength="160" autocomplete="email" aria-describedby={id('email')} />
      <span class="field__error" id={id('email')} data-error></span>
    </label>
    <label class="field">
      <span class="field__label">Zvíře (druh, jméno)</span>
      <input type="text" name="zvire" maxlength="120" placeholder="např. pes – Rex" />
    </label>
    <label class="field field--full">
      <span class="field__label">Zpráva <abbr title="povinné">*</abbr></span>
      <textarea name="zprava" rows="6" required maxlength="5000" aria-describedby={id('zprava')}></textarea>
      <span class="field__error" id={id('zprava')} data-error></span>
    </label>
    <div class="field--full cform__consent">
      <label class="check">
        <input type="checkbox" name="souhlas" value="1" required aria-describedby={id('souhlas')} />
        <span>
          Souhlasím se <a href="/ochrana-osobnich-udaju/" target="_blank" rel="noopener">zpracováním osobních údajů</a> za účelem vyřízení
          mého dotazu. <abbr title="povinné">*</abbr>
        </span>
      </label>
      <span class="field__error" id={id('souhlas')} data-error></span>
    </div>
  </div>

  <p class="cform__note">
    V akutních případech nám prosím volejte – zprávy z formuláře vyřizujeme v pracovní době.
  </p>

  <div class="cform__actions">
    <button class="btn cform__submit" type="submit" data-submit>Odeslat zprávu</button>
    <p class="cform__status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<style>
  .cform {
    font-family: var(--f-head);
  }

  .cform__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cform__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 20px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field__label {
    color: var(--c-ink);
    font-size: 15px;
    font-weight: 700;
  }

  abbr {
    color: var(--c-orange-deep);
    text-decoration: none;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid #e3d9d0;
    border-radius: 8px;
    background: #fffdfb;
    color: var(--c-ink);
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--c-orange);
    box-shadow: 0 0 0 3px rgba(249, 148, 32, 0.2);
  }

  .field [aria-invalid='true'] {
    border-color: #d64545;
  }

  /* Text chyby přímo u pole (barva nestačí jako jediný signál) */
  .field__error {
    color: #b42318;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
  }

  .field__error:empty {
    display: none;
  }

  .cform__consent .field__error:not(:empty) {
    display: block;
    margin: 6px 0 0 28px;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--c-text);
    font-size: 15px;
    line-height: 1.5;
  }

  .check input {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--c-orange);
  }

  .check a {
    color: var(--c-link);
    text-decoration: underline;
  }

  .check.is-invalid span {
    color: #b42318;
  }

  .cform__note {
    margin-top: 16px;
    color: #888;
    font-size: 14px;
  }

  .cform__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 18px;
  }

  .cform__submit {
    border: 0;
    cursor: pointer;
  }

  .cform__submit[disabled] {
    opacity: 0.6;
    cursor: wait;
  }

  .cform__status {
    flex: 1 1 260px;
    font-size: 16px;
    font-weight: 700;
  }

  .cform__status.is-ok {
    color: #2f8a3a;
  }

  .cform__status.is-error {
    color: #b42318;
  }

  .cform__status.is-info {
    color: var(--c-ink);
  }

  @media (max-width: 767px) {
    .cform__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { consentError, fieldError, resultText } from '../lib/kontaktni-formular';

  document.querySelectorAll<HTMLFormElement>('[data-cform]').forEach((form) => {
    const ts = form.querySelector<HTMLInputElement>('[data-ts]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const consent = form.querySelector<HTMLInputElement>('input[name="souhlas"]')!;
    const checked = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[aria-describedby]')];
    ts.value = String(Math.floor(Date.now() / 1000));

    // Výsledek po odeslání bez JavaScriptu (odeslat.php přesměruje zpět s ?odeslano=…&chyba=…)
    const params = new URLSearchParams(location.search);
    const sent = params.get('odeslano');
    if (sent) {
      const r = resultText(sent, params.get('chyba'));
      setStatus(r.ok ? 'ok' : 'error', r.text);
      form.scrollIntoView({ block: 'center' });
    }

    function setStatus(kind: 'ok' | 'error' | 'info', text: string) {
      status.textContent = text;
      status.classList.toggle('is-ok', kind === 'ok');
      status.classList.toggle('is-error', kind === 'error');
      status.classList.toggle('is-info', kind === 'info');
    }

    // Zkontroluje pole, zobrazí u něj chybu a vrátí, zda je v pořádku
    function check(el: HTMLInputElement | HTMLTextAreaElement) {
      const message = el === consent ? consentError(consent.checked) : fieldError(el.name, el.value);
      const error = document.getElementById(el.getAttribute('aria-describedby')!)!;
      error.textContent = message;
      if (el === consent) el.closest('.check')?.classList.toggle('is-invalid', Boolean(message));
      el.setAttribute('aria-invalid', String(Boolean(message)));
      return !message;
    }

    // Po prvním upozornění se chyba aktualizuje průběžně, jakmile ji návštěvník opraví
    checked.forEach((el) =>
      el.addEventListener(el === consent ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid') === 'true') check(el);
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = checked.filter((el) => !check(el));
      if (invalid.length) {
        setStatus('error', invalid.length === 1 ? 'Zkontrolujte prosím zvýrazněné pole.' : 'Zkontrolujte prosím zvýrazněná pole.');
        invalid[0].focus();
        return;
      }
      if (form.dataset.preview) {
        setStatus('info', 'Na náhledu webu se zprávy neodesílají – formulář bude fungovat na ostrém webu.');
        return;
      }
      submit.disabled = true;
      setStatus('info', 'Odesílám…');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          form.reset();
          ts.value = String(Math.floor(Date.now() / 1000));
          setStatus('ok', 'Děkujeme, zpráva byla odeslána. Ozveme se Vám co nejdříve.');
          (window as any).dataLayer?.push({ event: 'contactFormSubmit', formSource: form.zdroj?.value });
        } else {
          setStatus('error', data.error || 'Zprávu se nepodařilo odeslat. Zkuste to prosím znovu nebo nám zavolejte.');
        }
      } catch {
        setStatus('error', 'Zprávu se nepodařilo odeslat (chyba připojení). Zkuste to prosím znovu nebo nám zavolejte.');
      } finally {
        submit.disabled = false;
      }
    });
  });
</script>
