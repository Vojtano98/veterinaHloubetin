---
import { Image } from 'astro:assets';
import { animals, formatDate, isoDate, type Article } from '../lib/articles';

interface Props {
  article: Article;
  headingLevel?: 'h2' | 'h3';
  showExcerpt?: boolean;
}

const { article, headingLevel: H = 'h2', showExcerpt = true } = Astro.props;
const { title, cover, pubDate, excerpt, description, zvirata } = article.data;
const href = `/${article.id}/`;
const perex = excerpt || description;
---

<article class="acard">
  <a href={href} class="acard__img" tabindex="-1" aria-hidden="true">
    <Image src={cover} alt="" width={400} height={250} widths={[400, 800]} sizes="(max-width: 767px) 90vw, 360px" />
  </a>
  <div class="acard__body">
    <H class="acard__title"><a href={href}>{title}</a></H>
    <p class="acard__meta">
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      {zvirata.map((z) => <span class="acard__tag">{animals[z]}</span>)}
    </p>
    {showExcerpt && perex && <p class="acard__excerpt">{perex}</p>}
    <a href={href} class="acard__more" aria-hidden="true" tabindex="-1">Číst článek →</a>
  </div>
</article>

<style>
  .acard {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid #f0e8e0;
    border-radius: 16px;
    background: var(--c-white);
    box-shadow: 0 10px 30px -20px rgba(0, 0, 0, 0.35);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .acard:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 24px -8px rgba(0, 0, 0, 0.2);
  }

  .acard__img {
    display: block;
    overflow: hidden;
    aspect-ratio: 8 / 5;
  }

  .acard__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .acard:hover .acard__img :global(img) {
    transform: scale(1.04);
  }

  .acard__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 20px 22px 22px;
  }

  .acard__title {
    padding-bottom: 10px;
    font-family: var(--f-head);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.3;
  }

  .acard__title a {
    color: var(--c-heading);
  }

  .acard__title a:hover {
    color: var(--c-accent-text);
    opacity: 1;
  }

  .acard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 0;
    color: var(--c-label);
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 700;
  }

  .acard__meta time {
    margin-right: 4px;
  }

  .acard__tag {
    padding: 2px 9px;
    border-radius: 100px;
    background: var(--c-cream);
    color: var(--c-accent-text);
    font-size: 12px;
    font-weight: 800;
  }

  .acard__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 10px;
    padding: 0;
    color: #555;
    font-family: var(--f-head);
    font-size: 15px;
    line-height: 1.6em;
  }

  .acard__more {
    margin-top: auto;
    padding-top: 12px;
    color: var(--c-accent-text);
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
  }
</style>
