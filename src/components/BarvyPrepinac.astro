---
// DOČASNĚ – jen na náhledu (PUBLIC_PREVIEW=1): přepínání barevných variant k porovnání (etapa 3, AUDIT P1-4).
// Varianty jsou v src/styles/global.css (:root[data-barvy]). Po výběru varianty komponentu i varianty odstranit.
// Odkaz s ?barvy=a nebo ?barvy=a2 rovnou otevře danou variantu; volba se pamatuje v rámci záložky.
---

<script is:inline>
  // Nastavit variantu ještě před vykreslením obsahu stránky
  (function () {
    var v = null;
    try {
      var p = new URLSearchParams(location.search).get('barvy');
      if (p) sessionStorage.setItem('barvy', p);
      v = sessionStorage.getItem('barvy');
    } catch (e) {}
    if (v === 'a' || v === 'a2') document.documentElement.dataset.barvy = v;
  })();
</script>

<div class="barvy" role="group" aria-label="Porovnání barev (jen na náhledu)" data-barvy-panel>
  <span class="barvy__title">Barvy:</span>
  <button type="button" data-barvy-volba="puvodni">Původní</button>
  <button type="button" data-barvy-volba="a">A</button>
  <button type="button" data-barvy-volba="a2">A2</button>
</div>

<style>
  .barvy {
    position: fixed;
    left: 16px;
    bottom: 20px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px 6px 5px 12px;
    border-radius: 100px;
    background: #222;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    color: #fff;
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 700;
  }

  .barvy__title {
    padding-right: 4px;
  }

  .barvy button {
    min-width: 34px;
    padding: 6px 10px;
    border: 0;
    border-radius: 100px;
    background: transparent;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  .barvy button[aria-pressed='true'] {
    background: #fff;
    color: #222;
  }

  @media (max-width: 767px) {
    .barvy {
      left: 10px;
      bottom: calc(80px + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-barvy-panel]');
  if (panel) {
    const root = document.documentElement;
    const sync = () =>
      panel.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.barvyVolba === (root.dataset.barvy ?? 'puvodni')));
      });
    panel.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-barvy-volba]');
      if (!b) return;
      const v = b.dataset.barvyVolba!;
      if (v === 'puvodni') delete root.dataset.barvy;
      else root.dataset.barvy = v;
      try {
        sessionStorage.setItem('barvy', v);
      } catch {}
      sync();
    });
    sync();
  }
</script>
