---
import { site } from '../data/site';
---

<div class="info-bar">
  <a class="info-bar__full" href="/kontakty/">{site.hoursBar} <strong>Těšíme se na Vás.</strong></a>
  <span class="info-bar__short">
    <a href="/kontakty/">Po–Pá 8–19 · So 8–12 · Ne 16–18</a> ·
    <a class="nowrap info-bar__tel" href={site.phones.main.href}><strong>Pohotovost {site.phones.main.label}</strong></a>
  </span>
</div>

<style>
  .info-bar {
    display: block;
    padding: 10px 16px;
    background: var(--c-orange-bar);
    color: var(--c-white);
    font-family: var(--f-body);
    font-size: 18px;
    line-height: 1.4;
    text-align: center;
  }

  .info-bar a {
    color: inherit;
  }

  .info-bar a:hover {
    opacity: 1;
  }

  .info-bar__tel strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (max-width: 980px) {
    .info-bar {
      font-size: 17px;
    }
  }

  .info-bar__short {
    display: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .info-bar {
      font-size: 13px;
      padding: 7px 10px;
    }
    .info-bar__full {
      display: none;
    }
    .info-bar__short {
      display: inline;
    }
  }
</style>
