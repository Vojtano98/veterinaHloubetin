---
import { site } from '../data/site';
---

<!-- Hodiny jsou v hlavičce (stav Otevřeno) a v boxu pod bannerem, lišta proto nese jen pohotovost -->
<div class="info-bar">
  <a class="info-bar__tel" href={site.phones.main.href}>
    <span class="info-bar__full">Pohotovost poskytujeme po předchozí telefonické domluvě:</span>
    <span class="info-bar__short">Pohotovost:</span>
    <strong class="nowrap">{site.phones.main.label}</strong>
  </a>
</div>

<style>
  .info-bar {
    display: block;
    padding: 8px 16px;
    background: var(--c-orange-bar);
    color: var(--c-white);
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
  }

  .info-bar a {
    color: inherit;
  }

  .info-bar a:hover {
    opacity: 1;
  }

  .info-bar__tel {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 6px;
  }

  .info-bar__tel strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info-bar__short {
    display: none;
  }

  .nowrap {
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .info-bar {
      font-size: 14px;
      padding: 7px 10px;
    }
    .info-bar__full {
      display: none;
    }
    .info-bar__short {
      display: inline;
    }
  }
</style>
