---
import { site } from '../data/site';
---

<!-- Hodiny jsou v hlavičce (stav Otevřeno) a v boxu pod bannerem, lišta proto nese jen pohotovost -->
<div class="info-bar" data-info-bar data-vyjimky={JSON.stringify(site.vyjimky)}>
  <!-- Oznámení mimořádné pohotovosti – zobrazí ho skript jen v daném okně -->
  <a class="info-bar__tel info-bar__special" href={site.phones.main.href} hidden data-special>
    <span data-special-text></span>
    <span class="nowrap"><span data-special-last></span> <strong>{site.phones.main.label}</strong></span>
  </a>
  <a class="info-bar__tel" href={site.phones.main.href} data-regular>
    <span class="info-bar__full">Pohotovost poskytujeme po předchozí telefonické domluvě:</span>
    <span class="info-bar__short">Pohotovost:</span>
    <strong class="nowrap">{site.phones.main.label}</strong>
  </a>
</div>

<script>
  import { barText, type Vyjimka } from '../lib/vyjimky';

  document.querySelectorAll<HTMLElement>('[data-info-bar]').forEach((bar) => {
    const list: Vyjimka[] = JSON.parse(bar.dataset.vyjimky || '[]');
    const special = bar.querySelector<HTMLElement>('[data-special]')!;
    const regular = bar.querySelector<HTMLElement>('[data-regular]')!;
    const update = () => {
      const text = barText(list);
      // Poslední slovo („pohotovost:“) drží pohromadě s telefonem
      const cut = (text ?? '').lastIndexOf(' ');
      special.querySelector('[data-special-text]')!.textContent = text ? text.slice(0, cut) : '';
      special.querySelector('[data-special-last]')!.textContent = text ? text.slice(cut + 1) : '';
      special.hidden = !text;
      regular.hidden = Boolean(text);
      bar.classList.toggle('is-special', Boolean(text));
    };
    update();
    setInterval(update, 60_000);
  });
</script>

<style>
  .info-bar {
    display: block;
    padding: 8px 16px;
    background: var(--c-orange-bar);
    color: var(--c-white);
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
  }

  .info-bar a {
    color: inherit;
  }

  .info-bar a:hover {
    opacity: 1;
  }

  .info-bar__tel {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 6px;
  }

  .info-bar__tel .nowrap strong,
  .info-bar__tel > strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info-bar__short {
    display: none;
  }

  .info-bar [hidden] {
    display: none;
  }

  /* Mimořádné oznámení – tmavší, aby bylo vidět */
  .info-bar.is-special {
    background: #b45309;
    font-weight: 700;
  }

  .nowrap {
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .info-bar {
      font-size: 14px;
      padding: 7px 10px;
    }
    .info-bar__full {
      display: none;
    }
    .info-bar__short {
      display: inline;
    }
  }
</style>
