---
import { site } from '../data/site';
import { validateVyjimky } from '../lib/vyjimky';

// Chybně zapsaná výjimka (tvar data, letní/zimní čas) zastaví build – jinak by se lišta tiše ukázala ve špatnou dobu
const problems = validateVyjimky(site.vyjimky);
if (problems.length) throw new Error(`Chyba ve výjimkách v src/data/site.ts:\n- ${problems.join('\n- ')}`);

// Ordinační hodiny do lišty – plný text na desktopu, zkrácený na mobilu; dnešní den zvýrazní skript
const fullName: Record<string, string> = { So: 'sobota', Ne: 'neděle' };
const hours = site.hours.map((h) => ({
  days: h.schema.join(' '),
  full: `${fullName[h.short] ?? h.short} ${h.time}`,
  short: `${h.short} ${h.time.replace(/:00/g, '')}`,
}));
---

<!-- Běžně ordinační hodiny; pohotovost jen jako mimořádné oznámení (site.vyjimky) -->
<div class="info-bar" data-info-bar data-vyjimky={JSON.stringify(site.vyjimky)}>
  <!-- Oznámení mimořádné pohotovosti – zobrazí ho skript jen v daném okně -->
  <a class="info-bar__hours" href="/kontakty/" hidden data-special-hours>
    <span data-hours-text></span>
    <span class="info-bar__full">Ostatní dny dle ordinačních hodin.</span>
  </a>
  <a class="info-bar__tel info-bar__special" href={site.phones.main.href} hidden data-special>
    <span data-special-text></span>
    <span class="nowrap"><span data-special-last></span> <strong>{site.phones.main.label}</strong></span>
  </a>
  <a class="info-bar__hours" href="/kontakty/" data-regular>
    <span class="info-bar__full">
      Standardní provoz:
      {hours.map((h, i) => (
        <>
          <span class="nowrap" data-days={h.days}>{h.full}</span>{i < hours.length - 1 ? ', ' : '.'}
        </>
      ))}
      <strong>Těšíme se na Vás.</strong>
    </span>
    <span class="info-bar__short">
      {hours.map((h, i) => (
        <>
          <span class="nowrap" data-days={h.days}>{h.short}</span>{i < hours.length - 1 ? ' · ' : ''}
        </>
      ))}
    </span>
  </a>
</div>

<script>
  import { barInfo, type Vyjimka } from '../lib/vyjimky';

  document.querySelectorAll<HTMLElement>('[data-info-bar]').forEach((bar) => {
    const list: Vyjimka[] = JSON.parse(bar.dataset.vyjimky || '[]');
    const special = bar.querySelector<HTMLElement>('[data-special]')!;
    const specialHours = bar.querySelector<HTMLElement>('[data-special-hours]')!;
    const regular = bar.querySelector<HTMLElement>('[data-regular]')!;
    const update = () => {
      const info = barInfo(list);
      const emergency = info?.kind === 'pohotovost' ? info.text : '';
      // Poslední slovo („pohotovost:“) drží pohromadě s telefonem
      const cut = emergency.lastIndexOf(' ');
      special.querySelector('[data-special-text]')!.textContent = emergency ? emergency.slice(0, cut) : '';
      special.querySelector('[data-special-last]')!.textContent = emergency ? emergency.slice(cut + 1) : '';
      specialHours.querySelector('[data-hours-text]')!.textContent = info?.kind === 'hodiny' ? info.text : '';
      special.hidden = info?.kind !== 'pohotovost';
      specialHours.hidden = info?.kind !== 'hodiny';
      regular.hidden = Boolean(info);
      bar.classList.toggle('is-special', Boolean(info));

      // Zvýraznění dnešního dne (podle času v Praze), po půlnoci se přesune samo
      const today = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Prague', weekday: 'short' }).format(new Date()).slice(0, 2);
      bar.querySelectorAll<HTMLElement>('[data-days]').forEach((el) => {
        el.classList.toggle('is-today', (el.dataset.days ?? '').split(' ').includes(today));
      });
    };
    update();
    setInterval(update, 60_000);
  });
</script>

<style>
  .info-bar {
    display: block;
    padding: 8px 16px;
    background: var(--c-bar);
    color: var(--c-on-bar);
    font-family: var(--f-body);
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
  }

  .info-bar a {
    color: inherit;
  }

  .info-bar a:hover {
    opacity: 1;
  }

  .info-bar__tel {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 6px;
  }

  .info-bar__tel .nowrap strong,
  .info-bar__tel > strong {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info-bar__short {
    display: none;
  }

  .info-bar .is-today {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info-bar [hidden] {
    display: none;
  }

  /* Mimořádné oznámení – tmavší, aby bylo vidět */
  .info-bar.is-special {
    background: var(--c-bar-special);
    color: var(--c-on-bar-special);
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .info-bar {
      font-size: 14px;
      padding: 7px 10px;
    }
    .info-bar__full {
      display: none;
    }
    .info-bar__short {
      display: inline;
    }
  }
</style>
