---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import petExpert from '../assets/uploads/2024/10/PetExpert-conversion.webp';
---

<section class="facts" aria-labelledby="info-title">
  <div class="row">
    <header class="facts__head">
      <p class="eyebrow">Než k nám přijdete</p>
      <h2 id="info-title" class="facts__title">Důležité informace</h2>
    </header>

    <ul class="facts__grid">
      <li class="fact fact--alert">
        <span class="fact__icon"><Icon name="siren" size={24} /></span>
        <h3 class="fact__title">Pohotovost</h3>
        <p>Pohotovost poskytujeme po předchozí telefonické domluvě.</p>
        <a class="fact__action" href={site.phones.main.href}>
          <Icon name="phone" size={16} />
          {site.phones.main.label}
        </a>
      </li>

      <li class="fact">
        <span class="fact__icon"><Icon name="calendar" size={24} /></span>
        <h3 class="fact__title">Online objednání</h3>
        <p>
          Online se objednáte nejen na základní úkony, jako jsou vakcinace a čipování, ale i pokud Vašeho mazlíka trápí
          nějaký problém.
        </p>
        <a class="fact__action" href="/rezervace-sluzeb/">
          Objednat se online <Icon name="arrow" size={16} />
        </a>
      </li>

      <li class="fact">
        <span class="fact__icon"><Icon name="card" size={24} /></span>
        <h3 class="fact__title">Platba</h3>
        <p>Z technických důvodů nepřijímáme platební karty. Děkujeme za pochopení.</p>
      </li>

      <li class="fact fact--partner">
        <span class="fact__icon"><Icon name="shield" size={24} /></span>
        <h3 class="fact__title">Pojištění mazlíčků</h3>
        <p>Naše klinika spolupracuje s pojišťovnou <strong>PetExpert</strong>.</p>
        <Image src={petExpert} alt="PetExpert by Trupanion" width={220} class="fact__logo" loading="lazy" />
      </li>
    </ul>
  </div>
</section>

<style>
  .facts {
    padding: 50px 0 30px;
  }

  .facts__head {
    margin-bottom: 30px;
    text-align: center;
  }

  .facts__title {
    padding: 0;
    color: var(--c-ink);
    font-family: var(--f-head);
    font-size: 42px;
    font-weight: 800;
    line-height: 1.2;
  }

  .facts__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact {
    display: flex;
    flex-direction: column;
    padding: 26px 22px 24px;
    border: 1px solid #f0e8e0;
    border-radius: 18px;
    background: var(--c-white);
    box-shadow: 0 10px 30px -20px rgba(0, 0, 0, 0.35);
    font-family: var(--f-head);
    font-size: 15px;
    line-height: 1.6;
    color: #555;
  }

  .fact__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 16px;
    border-radius: 14px;
    background: var(--c-cream);
    color: var(--c-orange-deep);
  }

  .fact__title {
    padding-bottom: 8px;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 19px;
    font-weight: 800;
    line-height: 1.25;
  }

  .fact p {
    padding-bottom: 14px;
  }

  .fact strong {
    color: var(--c-ink);
  }

  .fact__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    color: var(--c-orange-deep);
    font-size: 15px;
    font-weight: 800;
  }

  .fact__action:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Pohotovost zvýrazněná */
  .fact--alert {
    border-color: transparent;
    background: linear-gradient(150deg, #f99420 0%, #ff7a1a 100%);
    color: #fff5ea;
    box-shadow: 0 16px 30px -16px rgba(255, 112, 0, 0.6);
  }

  .fact--alert .fact__icon {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
  }

  .fact--alert .fact__title {
    color: #fff;
  }

  .fact--alert .fact__action {
    align-self: flex-start;
    padding: 10px 18px;
    border-radius: 100px;
    background: #fff;
    color: var(--c-orange-deep);
    font-size: 16px;
  }

  .fact--alert .fact__action:hover {
    text-decoration: none;
  }

  .fact :global(.fact__logo) {
    width: 80%;
    max-width: 190px;
    height: auto;
    margin-top: auto;
  }

  @media (max-width: 1100px) {
    .facts__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .facts {
      padding: 36px 0 20px;
    }
    .facts__title {
      font-size: 30px;
    }
    .facts__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .fact {
      padding: 20px 18px;
    }
  }
</style>
