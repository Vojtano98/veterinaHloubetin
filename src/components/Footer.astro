---
import { Image } from 'astro:assets';
import { footerNav, site } from '../data/site';
import Icon from './Icon.astro';
import OpenStatus from './OpenStatus.astro';
import logo from '../assets/uploads/2024/05/Upload-Image-removebg-preview.png';

const year = new Date().getFullYear();
// CookieYes otevře nastavení souhlasu po kliknutí na prvek s třídou cky-banner-element (v náhledu CookieYes neběží)
const hasCookieYes = import.meta.env.PUBLIC_PREVIEW !== '1';
---

<footer class="site-footer">
  <div class="row footer-grid">
    <div class="footer-about">
      <a href="/" class="footer-logo" aria-label={`${site.name} – úvodní stránka`}>
        <Image src={logo} alt={site.name} width={400} />
      </a>
      <p class="about-1">
        Veterinární klinika Hloubětín se zaměřuje na prevenci, diagnostiku a léčbu nemocí malých zvířat od roku 2008.
      </p>
      <p class="about-2">Veterinární klinika pro oblast Praha 9, Praha 14, Praha-Hloubětín a široké okolí.</p>
      <div class="footer-social">
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={16} /></a>
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={16} /></a>
      </div>
    </div>

    <nav aria-labelledby="footer-menu">
      <h2 id="footer-menu" class="footer-title">Menu</h2>
      <ul class="footer-links">
        {footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="footer-title">Kontakt</h2>
      <ul class="footer-contact">
        <li>
          <Icon name="pin" size={16} />
          <a href={site.mapsUrl} target="_blank" rel="noopener">
            {site.address.street}<br />
            <span class="nowrap">{site.address.city}, {site.address.zip}</span><br />
            <span class="footer-note">{site.address.note}</span>
          </a>
        </li>
        <li>
          <Icon name="phone" size={16} />
          <a href={site.phones.main.href}><strong>{site.phones.main.label}</strong></a>
        </li>
        <li>
          <Icon name="mail" size={16} />
          <a href={`mailto:${site.email}`}>{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="footer-title">Ordinační hodiny</h2>
      <dl class="footer-hours">
        {
          site.hours.map((h) => (
            <div>
              <dt>{h.days}</dt>
              <dd>{h.time}</dd>
            </div>
          ))
        }
      </dl>
      <OpenStatus compact class="footer-status" />
    </div>
  </div>

  <div class="row footer-bottom">
    <p>© {year} {site.company} · <span class="nowrap">IČO {site.ico}</span></p>
    <ul class="footer-legal">
      <li><a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></li>
      {
        hasCookieYes && (
          <li>
            <button type="button" class="cky-banner-element footer-cookies">Nastavení cookies</button>
          </li>
        )
      }
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    padding: 19px 0 0;
    background: var(--c-footer);
    color: var(--c-ink);
    font-family: var(--f-head);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.8fr) minmax(0, 1.35fr) minmax(0, 1.1fr);
    gap: 40px;
    padding-top: 44px;
    padding-bottom: 36px;
  }

  .footer-logo {
    display: block;
    width: 150px;
    margin-bottom: 16px;
  }

  /* Obrázek loga je čtvercový s průhledným okrajem – ořízneme ho na samotné logo */
  .footer-logo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 447 / 261;
    object-fit: cover;
    object-position: 50% 39%;
  }

  .nowrap {
    white-space: nowrap;
  }

  .about-1,
  .about-2 {
    max-width: 340px;
    margin-bottom: 6px;
    padding-bottom: 1px;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .about-1 {
    font-weight: 600;
    color: var(--c-ink);
  }

  .footer-social {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }

  .footer-social a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-white);
    color: var(--c-ink);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    transition: background 200ms ease, color 200ms ease;
  }

  .footer-social a:hover {
    opacity: 1;
    background: var(--c-orange);
    color: var(--c-white);
  }

  .footer-title {
    margin-bottom: 12px;
    padding: 0;
    color: #8a7a6c;
    font-family: var(--f-head);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .footer-links,
  .footer-contact,
  .footer-legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding: 5px 0;
    color: var(--c-ink);
    font-size: 16px;
    font-weight: 600;
  }

  .footer-links a:hover,
  .footer-contact a:hover,
  .footer-legal a:hover,
  .footer-cookies:hover {
    opacity: 1;
    color: var(--c-orange-deep);
  }

  .footer-contact {
    display: grid;
    gap: 12px;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }

  .footer-contact :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--c-orange-deep);
  }

  .footer-contact a {
    min-width: 0;
    color: var(--c-ink);
    overflow-wrap: break-word;
  }

  .footer-contact strong {
    font-weight: 800;
  }

  .footer-note {
    color: #6b6b6b;
    font-size: 14px;
    font-weight: 500;
  }

  .footer-hours {
    margin: 0;
  }

  .footer-hours div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    font-size: 15px;
  }

  .footer-hours div:last-child {
    border-bottom: 0;
  }

  .footer-hours dt {
    color: #4a4a4a;
    font-weight: 600;
  }

  .footer-hours dd {
    margin: 0;
    color: var(--c-ink);
    font-weight: 800;
    white-space: nowrap;
  }

  .footer-grid :global(.footer-status) {
    margin-top: 10px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 18px 0 22px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    color: #555;
    font-size: 14px;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 20px;
  }

  .footer-legal li {
    display: flex;
  }

  .footer-legal a,
  .footer-cookies {
    padding: 4px 0;
    border: 0;
    background: none;
    color: #555;
    font: inherit;
    font-weight: 700;
    line-height: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 40px;
    }
  }

  @media (max-width: 767px) {
    .footer-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 28px 18px;
      padding-top: 24px;
    }
    .footer-about {
      grid-column: 1 / -1;
    }
    .footer-logo {
      width: 130px;
    }
    .footer-grid > div:last-child {
      grid-column: 1 / -1;
    }
    .footer-contact li {
      font-size: 15px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      /* Místo pro tlačítko „nahoru“ nad spodní lištou */
      padding-bottom: 64px;
    }
  }
</style>
