---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wave from '../components/Wave.astro';
import InfoBox from '../components/InfoBox.astro';
import Reviews from '../components/Reviews.astro';
import ServicesSection from '../components/ServicesSection.astro';
import InfoSection from '../components/InfoSection.astro';
import TeamSection from '../components/TeamSection.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import heroDog from '../assets/uploads/2025/05/HP-pes.webp';

const hero = await getImage({ src: heroDog, width: 1417, format: 'webp', quality: 75 });
const heroSm = await getImage({ src: heroDog, width: 800, format: 'webp', quality: 70 });
---

<Base
  title="Veterinární klinika Hloubětín - jsme tu pro vás a vaše mazlíčky"
  rawTitle
  description="Veterinární klinika Hloubětín se zaměřuje na prevenci, diagnostiku a léčbu nemocí malých zvířat od roku 2008. Psi, kočky, drobní savci, plazi i exotičtí ptáci. Praha 9 – u metra Hloubětín."
>
  <!-- Fotka psa je v CSS pozadí, prohlížeč by ji jinak našel až po stažení stylů – přednačíst správnou velikost -->
  <link slot="head" rel="preload" as="image" href={hero.src} media="(min-width: 981px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href={heroSm.src} media="(max-width: 980px)" fetchpriority="high" />

  <!-- HERO -->
  <section class="hero" style={`--hero:url(${hero.src});--hero-sm:url(${heroSm.src})`}>
    <div class="row hero__row">
      <div class="hero__text">
        <p class="hero__eyebrow">Praha 9 – Hloubětín · od roku 2008</p>
        <h1>Veterinární klinika Hloubětín</h1>
        <p class="hero__lead">
          Prevence, diagnostika a léčba psů, koček, drobných savců, plazů i exotických ptáků.
        </p>
        <!-- Dokud jsou tlačítka vidět, spodní mobilní lišta je schovaná (aby je nepřekrývala) -->
        <div class="hero__actions" data-mobilebar-hide>
          <a class="hero__btn hero__btn--primary" href="/rezervace-sluzeb/">
            <Icon name="calendar" size={18} />
            Objednat se
          </a>
          <!-- Na mobilu rovnou vytočí číslo, na počítači vede na Kontakty -->
          <a class="hero__btn hero__btn--ghost hero__desktop" href="/kontakty/">
            <Icon name="phone" size={18} />
            Kontaktujte nás
          </a>
          <a class="hero__btn hero__btn--ghost hero__mobile" href={site.phones.main.href}>
            <Icon name="phone" size={18} />
            Zavolat
          </a>
        </div>
        <a class="hero__more" href="#sluzby">
          Naše služby
          <Icon name="arrow" size={18} class="hero__more-icon" />
        </a>
      </div>
    </div>
    <div class="row row--wide hero__box">
      <InfoBox title="Kontakt a ordinační hodiny" />
    </div>
    <Wave variant="curve" position="bottom" color="#FFFFFF" height="5vw" />
  </section>

  <!-- RECENZE -->
  <section class="section reviews-section" aria-labelledby="recenze">
    <div class="row">
      <h2 id="recenze" class="reviews-title">Přečtěte si, co o nás říkají naši klienti</h2>
      <a href={site.firmyCz} target="_blank" rel="noopener" class="award">
        <img src="https://www.firmy.cz/top-firma/2025.svg" width="58" height="50" alt="" loading="lazy" />
        <span>Získali jsme ocenění <strong>TOP firma za rok 2025</strong> na Firmy.cz</span>
      </a>
      <Reviews />
    </div>
  </section>

  <ServicesSection />

  <InfoSection />

  <TeamSection />

  <div class="page-end"><Wave variant="waves" position="bottom" color="#f3eded" height="72px" /></div>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    z-index: 10;
    padding: 58px 0 0;
    background-color: var(--c-brown);
    background-image: linear-gradient(73deg, #8f6d4f 30%, rgba(143, 109, 79, 0.75) 50%, rgba(143, 109, 79, 0) 73%), var(--hero);
    background-position: right bottom;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .hero__row {
    z-index: 10;
    padding: 0;
  }

  .hero__text {
    width: 56%;
    margin: 70px 0 56px;
    color: var(--c-white);
    font-family: var(--f-head);
    text-shadow: 0 0 1.6em rgba(0, 0, 0, 0.3);
  }

  .hero__eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    padding: 6px 14px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.18);
    color: var(--c-white);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-shadow: none;
    backdrop-filter: blur(4px);
  }

  .hero__text h1 {
    padding-bottom: 16px;
    color: var(--c-white);
    font-family: var(--f-head);
    font-size: 64px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.5px;
  }

  .hero__lead {
    max-width: 560px;
    padding-bottom: 28px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 14px;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 15px 28px;
    border-radius: 100px;
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    text-shadow: none;
    text-transform: uppercase;
    transition: transform 200ms ease, box-shadow 200ms ease, background 200ms ease;
  }

  .hero__btn:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .hero__btn--primary {
    background: var(--c-cta);
    color: var(--c-on-cta);
    box-shadow: 0 14px 24px -10px rgba(120, 50, 0, 0.6);
  }

  .hero__btn--primary:hover {
    background: var(--c-cta-hover);
  }

  .hero__btn--ghost {
    border: 2px solid rgba(255, 255, 255, 0.85);
    color: var(--c-white);
  }

  .hero__btn--ghost:hover {
    background: var(--c-white);
    color: var(--c-ink);
  }

  .hero__mobile {
    display: none;
  }

  /* Textový odkaz na sekci služeb pod tlačítky */
  .hero__more {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 22px;
    color: var(--c-white);
    font-family: var(--f-head);
    font-size: 16px;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    text-shadow: none;
  }

  .hero__more:hover {
    opacity: 1;
    text-decoration-color: var(--c-orange);
  }

  .hero__more :global(.hero__more-icon) {
    transform: rotate(90deg);
    transition: transform 200ms ease;
  }

  .hero__more:hover :global(.hero__more-icon) {
    transform: rotate(90deg) translateX(3px);
  }

  .hero__box {
    z-index: 10;
    margin-top: 6vw;
    padding: 0 0 27px;
  }

  /* ---------- RECENZE ---------- */
  .reviews-section {
    padding: 80px 0 40px;
  }

  .reviews-section .row {
    padding-top: 0;
  }

  .reviews-title {
    margin-bottom: 8px;
    padding-right: 14px;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.4em;
    text-align: center;
  }

  /* Ocenění jako odznak pod nadpisem recenzí */
  .award {
    display: flex;
    width: fit-content;
    max-width: 100%;
    align-items: center;
    gap: 12px;
    margin: 0 auto 18px;
    padding: 6px 18px 6px 8px;
    border: 1px solid #f0e8e0;
    border-radius: 100px;
    background: var(--c-white);
    box-shadow: 0 8px 20px -16px rgba(0, 0, 0, 0.4);
    color: var(--c-ink);
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
  }

  .award:hover {
    opacity: 1;
    border-color: #f6d3b3;
  }

  .award img {
    flex: none;
    width: 58px;
    height: auto;
  }

  /* ---------- RESPONZIVITA ---------- */
  /* Menší notebooky: nadpis na dva řádky a tlačítka nad cookie lištou */
  @media (min-width: 981px) and (max-width: 1200px) {
    .hero__text h1 {
      font-size: 54px;
    }
  }

  @media (min-width: 981px) and (max-height: 820px) {
    .hero {
      padding-top: 24px;
    }
    .hero__text {
      margin-top: 32px;
    }
  }

  @media (max-width: 980px) {
    .hero__text {
      width: 100%;
      margin: 40px 0 40px;
    }
    .hero__text h1 {
      font-size: 54px;
    }
    .hero__box {
      margin-top: 0;
    }
  }

  @media (max-width: 767px) {
    .hero {
      /* Pes jako nízký pruh nahoře, aby nadpis zůstal nad cookie lištou */
      padding-top: 140px;
      background-image:
        linear-gradient(180deg, rgba(143, 109, 79, 0) 0, rgba(143, 109, 79, 0) 110px, #8f6d4f 200px),
        var(--hero-sm);
      background-size: 100% auto, 130% auto;
      background-position: 0 0, 88% -48px;
    }
    .hero__text {
      margin: 10px 0 30px;
    }
    .hero__eyebrow {
      font-size: 11px;
      letter-spacing: 1px;
    }
    .hero__text h1 {
      /* Dva řádky i na nejužších telefonech */
      font-size: clamp(28px, 8.4vw, 38px);
    }
    .hero__lead {
      font-size: 17px;
      padding-bottom: 22px;
    }
    .hero__actions {
      flex-direction: column;
    }
    .hero__btn {
      justify-content: center;
    }
    .hero__desktop {
      display: none;
    }
    .hero__mobile {
      display: inline-flex;
    }
    .hero__more {
    min-height: 44px;
      margin-top: 16px;
      font-size: 15px;
    }
    .hero__box {
      padding-bottom: 20px;
    }
    .reviews-section {
      padding: 48px 0 24px;
    }
    .reviews-title {
      font-size: 22px;
      padding-right: 0;
    }
    .award {
      gap: 10px;
      padding-right: 14px;
      border-radius: 16px;
      font-size: 13px;
    }
    .award img {
      width: 46px;
    }
  }

  /* Nízké telefony: cookie lišta zabere většinu obrazovky, nadpis musí být hned nahoře a pes je jen vpravo za ním */
  @media (max-width: 479px) and (max-height: 700px) {
    .hero {
      padding-top: 0;
      background-image:
        linear-gradient(180deg, rgba(143, 109, 79, 0) 170px, #8f6d4f 250px),
        linear-gradient(90deg, #8f6d4f 30%, rgba(143, 109, 79, 0.5) 100%),
        var(--hero-sm);
      background-size: auto, auto, auto 270px;
      background-position: 0 0, 0 0, right -20px;
    }
    .hero__text {
      margin: 18px 0 30px;
    }
  }

  /* Širší telefony a tablety: nízký pruh s psem vpravo, text pod ním přes celou šířku */
  @media (min-width: 480px) and (max-width: 980px) {
    .hero {
      padding-top: 190px;
      background-image:
        linear-gradient(180deg, rgba(143, 109, 79, 0) 150px, #8f6d4f 270px),
        linear-gradient(90deg, #8f6d4f calc(100% - 520px), rgba(143, 109, 79, 0) calc(100% - 300px)),
        var(--hero-sm);
      background-size: auto, auto, auto 340px;
      background-position: 0 0, 0 0, right -30px;
    }
    .hero__text {
      margin: 10px 0 30px;
    }
    .hero__text h1 {
      font-size: 40px;
    }
  }

  /* Telefon na šířku */
  @media (max-height: 500px) {
    .hero {
      padding-top: 0;
    }
    .hero__text {
      margin: 12px 0 24px;
    }
    .hero__eyebrow {
      display: none;
    }
  }

  @media (max-width: 360px) {
    .hero__eyebrow {
      padding: 5px 11px;
      font-size: 10px;
      letter-spacing: 0.4px;
    }
  }
</style>
