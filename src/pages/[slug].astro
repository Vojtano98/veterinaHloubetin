---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import InfoBox from '../components/InfoBox.astro';
import Wave from '../components/Wave.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getArticles, relatedArticles, formatDate, isoDate, readingTime, type Article } from '../lib/articles';
import { memberById } from '../data/team';
import { site } from '../data/site';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((article) => ({ params: { slug: article.id }, props: { article, all } }));
}

const { article, all } = Astro.props as { article: Article; all: Article[] };
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2);
const d = article.data;
const url = `${site.url}/${article.id}/`;
const author = memberById(d.author);
const reviewer = memberById(d.reviewedBy);
const related = relatedArticles(article, all);
const minutes = readingTime(article.body);
const mainImage = d.heroImage ?? d.cover;
// Obrázek pro sdílení odkazu: větší z fotek článku, alespoň 600 px na šířku (jinak obrázek kliniky)
const shareImage = [d.heroImage, d.cover]
  .filter((img): img is NonNullable<typeof img> => Boolean(img) && img!.width >= 600)
  .sort((a, b) => b.width - a.width)[0];
const ogImg = await getImage({ src: mainImage, width: 1200, format: 'jpg' });
const showUpdated = d.updatedDate && d.updatedDate.toDateString() !== d.pubDate.toDateString();
// Shrnutí a FAQ: na produkci jen po schválení veterinářem, ve vývoji jako označený návrh
const showAi = d.aiContentApproved || import.meta.env.DEV;
const aiDraft = !d.aiContentApproved;
const summary = showAi ? d.summary : undefined;
const faq = showAi ? (d.faq ?? []) : [];

const person = (m: NonNullable<ReturnType<typeof memberById>>) => ({
  '@type': 'Person',
  name: m.name,
  jobTitle: m.title,
  worksFor: { '@id': `${site.url}/#organization` },
  url: `${site.url}/#onas`,
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description || undefined,
    image: [new URL(ogImg.src, site.url).href],
    datePublished: isoDate(d.pubDate),
    dateModified: isoDate(d.updatedDate ?? d.pubDate),
    inLanguage: 'cs-CZ',
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: author ? person(author) : { '@id': `${site.url}/#organization` },
    ...(reviewer ? { reviewedBy: person(reviewer) } : {}),
    publisher: { '@id': `${site.url}/#organization` },
    isPartOf: { '@id': `${site.url}/clanky/` },
    wordCount: (article.body ?? '').split(/\s+/).filter(Boolean).length,
  },
  ...(d.aiContentApproved && faq.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: faq.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<Base
  title={d.seoTitle ?? d.title}
  description={d.description || d.excerpt || site.description}
  image={shareImage}
  type="article"
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate}
  jsonLd={jsonLd}
  section="clanky"
>
  <article class="post" aria-labelledby="post-title">
    <div class="row post__column">
      <Breadcrumbs items={[{ label: 'Články', href: '/clanky/' }, { label: d.title }]} />

      <header class="post__header">
        <h1 id="post-title" class="post__title">{d.title}</h1>
        <p class="post__meta">
          <span>
            <Icon name="calendar" size={16} />
            Publikováno <time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time>
          </span>
          {
            showUpdated && (
              <span>
                Aktualizováno <time datetime={isoDate(d.updatedDate!)}>{formatDate(d.updatedDate!)}</time>
              </span>
            )
          }
          <span>
            {author ? (
              <>
                Autor: <a href="/#onas">{author.name}</a>
              </>
            ) : (
              <>Autor: {site.name}</>
            )}
          </span>
          {
            reviewer && (
              <span>
                Odborně zkontroloval(a): <a href="/#onas">{reviewer.name}</a>
              </span>
            )
          }
          <span>{minutes} min čtení</span>
        </p>
        {
          summary && (
            <div class:list={['post__summary', { 'is-draft': aiDraft }]}>
              {aiDraft && <span class="draft-badge">Návrh – čeká na schválení</span>}
              <p class="post__summary-label">Ve zkratce</p>
              <p>{summary}</p>
            </div>
          )
        }
      </header>

      {
        toc.length >= 4 && (
          <nav class="toc" aria-label="Obsah článku">
            <details open>
              <summary>Obsah článku</summary>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text.replace(/^[^\p{L}\p{N}]+/u, '')}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }

      <div class="post__body">
        <figure class="post__figure">
          <Image
            src={mainImage}
            alt={d.heroAlt ?? d.title}
            width={640}
            widths={[320, 640, 960]}
            sizes="(max-width: 767px) 92vw, 320px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <div class="prose">
          <Content />
        </div>
      </div>

      {
        faq.length > 0 && (
          <section class:list={['faq', { 'is-draft': aiDraft }]} aria-labelledby="faq-h">
            {aiDraft && <span class="draft-badge">Návrh – čeká na schválení</span>}
            <h2 id="faq-h" class="faq__title">
              Časté otázky
            </h2>
            {faq.map((f) => (
              <details class="faq__item">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )
      }

      {
        d.cta !== 'zadna' && (
          <aside class="post-cta card" aria-label="Objednání na vyšetření">
            <div>
              <p class="post-cta__title">Potřebujete poradit nebo objednat svého mazlíčka?</p>
              <p>
                Objednat se můžete online, telefonicky na{' '}
                <a href={site.phones.main.href}>{site.phones.main.label}</a> nebo přes{' '}
                <a href="/kontakty/#napiste-nam">kontaktní formulář</a>.
              </p>
            </div>
            <a class="btn" href="/rezervace-sluzeb/">
              Objednat se online
            </a>
          </aside>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <div class="row">
          <div class="related__head">
            <h2 id="related-h" class="related__title">
              Mohlo by vás zajímat
            </h2>
            <a class="related__all" href="/clanky/">
              Všechny články <Icon name="arrow" size={18} />
            </a>
          </div>
          <ul class="related__grid">
            {related.map((a) => (
              <li>
                <ArticleCard article={a} headingLevel="h3" showExcerpt={false} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Jediný kontaktní blok na konci článku (adresa, telefon, hodiny); e-mail a sítě jsou v patičce -->
  <section class="ask">
    <div class="row">
      <InfoBox title="Máte nějaké dotazy?" subtitle="Zavolejte nám, nebo se u nás rovnou zastavte." layout="stacked" />
    </div>
    <Wave variant="waves" position="bottom" color="#f3eded" height="72px" class="ask-wave" />
  </section>
</Base>

<style>
  /* Bez obecného banneru – článek začíná hned pod hlavičkou */
  .post {
    background: linear-gradient(180deg, var(--c-cream) 0, #fff 340px);
  }

  .post .row {
    padding-top: 30px;
  }

  .post :global(.crumbs a:not(:hover)) {
    background: var(--c-white);
  }

  .post__header {
    margin: 28px 0 30px;
  }

  .post__title {
    padding-bottom: 14px;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15em;
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    color: var(--c-muted);
    font-family: var(--f-head);
    font-size: 14px;
    font-weight: 600;
  }

  .post__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .post__meta a {
    color: var(--c-accent-text);
  }

  .post__meta :global(svg) {
    color: var(--c-orange-meta);
  }

  /* Celý článek v jednom čitelném sloupci (~70 znaků na řádek) */
  .post__column {
    max-width: 800px;
  }

  .post__body {
    display: flow-root;
  }

  /* Menší fotka vpravo, text ji zleva obtéká (kompaktní začátek článku) */
  .post__figure {
    float: right;
    width: 40%;
    max-width: 320px;
    margin: 6px 0 18px 28px;
  }

  .post__figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 440px;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 14px;
    box-shadow: 0 14px 30px -18px rgba(0, 0, 0, 0.45);
  }

  /* Bloky s pozadím (úvodní citát, tabulky) se zúží vedle fotky, místo aby pod ní podtékaly */
  .post__body .prose :global(:is(blockquote, table, pre, .callout)) {
    display: flow-root;
  }

  .post__summary {
    position: relative;
    margin-top: 22px;
    padding: 18px 22px;
    border-left: 4px solid var(--c-orange);
    border-radius: 0 10px 10px 0;
    background: var(--c-cream);
    color: var(--c-ink);
    font-family: var(--f-head);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.6;
  }

  .post__summary-label {
    padding-bottom: 4px;
    color: var(--c-accent-text);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .toc {
    margin: 0 0 30px;
    padding: 16px 22px;
    border: 1px solid #f1e3d6;
    border-radius: 10px;
    background: var(--c-white);
    font-family: var(--f-head);
  }

  .toc summary {
    color: var(--c-heading);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .toc ol {
    columns: 2;
    column-gap: 30px;
    margin: 12px 0 0;
    padding-left: 1.3em;
    line-height: 1.5;
  }

  .toc li {
    break-inside: avoid;
    margin-bottom: 6px;
  }

  .toc li::marker {
    color: var(--c-accent-bright);
    font-weight: 700;
  }

  .toc a {
    color: var(--c-ink);
    font-size: 15px;
    font-weight: 600;
  }

  .toc a:hover {
    opacity: 1;
    color: var(--c-accent-text);
  }

  @media (max-width: 767px) {
    .toc ol {
      columns: 1;
    }
  }

  .faq {
    position: relative;
    clear: both;
    margin-top: 40px;
    padding: 0 2%;
    font-family: var(--f-head);
  }

  .faq__title {
    padding-bottom: 16px;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 30px;
    font-weight: 700;
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line);
  }

  .faq__item summary {
    position: relative;
    padding: 16px 40px 16px 0;
    color: var(--c-ink);
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--c-accent-bright);
    font-size: 26px;
    font-weight: 400;
  }

  .faq__item[open] summary::after {
    content: '–';
  }

  .faq__item p {
    padding: 0 0 18px;
    color: var(--c-text);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.7;
  }

  .is-draft {
    outline: 2px dashed #e0574f;
    outline-offset: 6px;
  }

  .draft-badge {
    display: inline-block;
    margin-bottom: 8px;
    padding: 2px 10px;
    border-radius: 4px;
    background: #e0574f;
    color: #fff;
    font-family: var(--f-head);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .post-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 30px;
    margin-top: 40px;
    padding: 26px 30px;
    border-left: 5px solid var(--c-orange);
    background: var(--c-cream-2);
    font-family: var(--f-head);
    font-size: 16px;
    color: var(--c-ink);
  }

  .post-cta > div {
    flex: 1 1 420px;
  }

  .post-cta__title {
    padding-bottom: 6px;
    font-size: 21px;
    font-weight: 800;
    color: var(--c-heading);
  }

  .post-cta a:not(.btn) {
    color: var(--c-link);
    font-weight: 700;
  }

  .related {
    padding: 30px 0 10px;
  }

  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 20px;
    padding-bottom: 24px;
  }

  .related__all {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--c-accent-text);
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .related__all:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related__title {
    padding-bottom: 0;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 30px;
    font-weight: 700;
  }

  .related__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px 5.5%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Poslední sekce článku – vlnka přechází do patičky */
  .ask {
    position: relative;
    padding: 20px 0 calc(23px + 72px);
  }

  @media (max-width: 980px) {
    .post__title {
      font-size: 36px;
    }
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .post__header {
      margin: 24px 0 20px;
    }
    .post__title {
      font-size: 30px;
    }
    .post__figure {
      float: none;
      width: 100%;
      max-width: none;
      margin: 0 0 20px;
    }
    .post__figure :global(img) {
      max-height: 220px;
      border-radius: 12px;
    }
    .post-cta {
      padding: 22px 18px;
    }
    .related__grid {
      grid-template-columns: 1fr;
    }
    .ask {
      padding-bottom: 60px;
    }
    .ask :global(.ask-wave) {
      height: 44px !important;
    }
  }
</style>
