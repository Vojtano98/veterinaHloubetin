---
import Base from '../layouts/Base.astro';
import ContactCards from '../components/ContactCards.astro';
import { nav } from '../data/site';
---

<Base title="Stránka nenalezena" noindex>
  <section class="section nf">
    <div class="row">
      <p class="nf__code">404</p>
      <h1 class="nf__title">Tuto stránku jsme nenašli</h1>
      <p class="nf__text">Stránka mohla být přesunuta nebo už neexistuje. Zkuste některý z odkazů níže.</p>
      <ul class="nf__links">
        <li><a class="btn" href="/">Úvodní stránka</a></li>
        {nav.filter((n) => !n.href.startsWith('/#')).map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
  </section>
  <ContactCards />
</Base>

<style>
  .nf {
    text-align: center;
    background: linear-gradient(180deg, #fff6ef 0%, #fff 100%);
  }

  .nf__code {
    color: var(--c-orange);
    font-family: var(--f-head);
    font-size: 110px;
    font-weight: 800;
    line-height: 1;
  }

  .nf__title {
    padding: 10px 0;
    font-family: var(--f-head);
    font-size: 36px;
    font-weight: 700;
    color: var(--c-heading);
  }

  .nf__text {
    font-family: var(--f-head);
    font-size: 18px;
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 24px;
    margin-top: 30px;
    padding: 0;
    list-style: none;
  }

  .nf__links a:not(.btn) {
    color: var(--c-black);
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
