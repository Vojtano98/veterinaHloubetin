---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Reviews from '../components/Reviews.astro';
import InfoBox from '../components/InfoBox.astro';
import ContactCards from '../components/ContactCards.astro';
import Wave from '../components/Wave.astro';
import { animals, getArticles } from '../lib/articles';
import { site } from '../data/site';

const articles = await getArticles();
// Filtr nabízí jen zvířata, ke kterým existuje aspoň jeden článek
const filters = (Object.keys(animals) as (keyof typeof animals)[])
  .map((z) => ({ id: z, label: animals[z], count: articles.filter((a) => a.data.zvirata.includes(z)).length }))
  .filter((f) => f.count > 0);
const url = `${site.url}/clanky/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': url,
    url,
    name: 'Články o péči o domácí mazlíčky',
    description:
      'Odborné články veterinářů z Veterinární kliniky Hloubětín o péči o psy, kočky, drobné savce a plazy.',
    inLanguage: 'cs-CZ',
    isPartOf: { '@id': `${site.url}/#website` },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: articles.length,
      itemListElement: articles.map((a, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${site.url}/${a.id}/`,
        name: a.data.title,
      })),
    },
  }
];
---

<Base
  title="Články o péči o domácí mazlíčky"
  description="Objevte nejnovější články o péči o domácí mazlíčky. Získejte odborné rady od našich zkušených veterinářů – kastrace, parazité, zuby, chov želv a gekonů a další témata."
  jsonLd={jsonLd}
  section="clanky"
>
  <PageHero title="Články" subtitle="a další zajímavá témata" crumbs={[{ label: 'Články' }]} />

  <section class="listing" aria-label="Seznam článků">
    <Wave variant="arch" position="top" color="#FFFFFF" height="54vw" class="listing__wave" />
    <div class="row">
      <div class="filter" role="group" aria-label="Filtrovat články podle zvířete" data-filter hidden>
        <button type="button" class="filter__btn" aria-pressed="true" data-value="">Vše <span>{articles.length}</span></button>
        {
          filters.map((f) => (
            <button type="button" class="filter__btn" aria-pressed="false" data-value={f.id}>
              {f.label} <span>{f.count}</span>
            </button>
          ))
        }
      </div>
      <ul class="listing__grid" data-list>
        {
          articles.map((a) => (
            <li data-zvirata={a.data.zvirata.join(' ')}>
              <ArticleCard article={a} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="row">
      <h2 class="reviews-title">Přečtěte si, co o nás říkají naši klienti</h2>
      <Reviews />
    </div>
  </section>

  <section class="ask">
    <div class="row">
      <InfoBox title="Máte nějaké dotazy?" subtitle="Zavolejte nám, nebo se u nás rovnou zastavte." layout="stacked" />
    </div>
  </section>

  <ContactCards />
</Base>

<script>
  // Filtr článků podle zvířete – bez JavaScriptu se zobrazí všechny články
  const box = document.querySelector<HTMLElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-list] > li');
  if (box) {
    box.hidden = false;
    box.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
      if (!btn) return;
      const value = btn.dataset.value ?? '';
      box.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => {
        li.hidden = value !== '' && !(li.dataset.zvirata ?? '').split(' ').includes(value);
      });
    });
  }
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .filter[hidden] {
    display: none;
  }

  .filter__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid #f1d9c2;
    border-radius: 100px;
    background: var(--c-white);
    color: var(--c-ink);
    font-family: var(--f-head);
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }

  .filter__btn span {
    color: #8a7a6c;
    font-size: 13px;
  }

  .filter__btn:hover {
    border-color: var(--c-orange);
  }

  .filter__btn[aria-pressed='true'] {
    border-color: var(--c-orange);
    background: var(--c-orange);
    color: var(--c-white);
  }

  .filter__btn[aria-pressed='true'] span {
    color: rgba(255, 255, 255, 0.85);
  }

  .listing__grid > li[hidden] {
    display: none;
  }

  .listing {
    position: relative;
    padding: 10px 0 35px;
    background-color: var(--c-cream);
    background-image: linear-gradient(180deg, #fff6ef 0%, #ffffff 100%);
  }

  .listing :global(.listing__wave) {
    max-height: 520px;
  }

  .listing .row {
    z-index: 2;
  }

  .listing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 3.5%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reviews-title {
    padding: 25px 0 8px;
    color: var(--c-black);
    font-family: var(--f-head);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.2em;
    text-align: center;
  }

  .ask {
    padding: 0 0 23px;
  }

  @media (max-width: 980px) {
    .listing__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .listing__grid {
      grid-template-columns: 1fr;
    }
    .reviews-title {
      font-size: 24px;
    }
  }
</style>
