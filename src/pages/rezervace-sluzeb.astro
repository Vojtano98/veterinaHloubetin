---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHero from '../components/PageHero.astro';
import ContactCards from '../components/ContactCards.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import heroImg from '../assets/uploads/2024/05/Untitled-design-1920x1280-2.jpg';
---

<Base
  title="Rezervace služeb"
  description="Vyberte si čas dle vaší potřeby a zarezervujte si návštěvu na naší klinice ještě dnes. Veterinární klinika Hloubětín – online objednání na vakcinaci, čipování i vyšetření."
>
  <PageHero title="Rezervace služeb" image={heroImg} position="center 10%" />

  <section class="section rez">
    <div class="row">
      <Breadcrumbs items={[{ label: 'Rezervace služeb' }]} class="page-crumbs" />
      <p class="rez__lead"><strong>Pro objednání na základní úkony vašeho mazlíka můžete využít tento objednávací formulář.</strong></p>
      <p class="rez__note"><em>Je potřeba Vás objednat ke konkrétnímu doktorovi.</em> Nenajdete svůj požadavek ve formuláři? <a href="#jine-objednani">Objednejte se telefonicky</a>.</p>

      <div class="rez__widget">
        <!-- Rezervační formulář Reservanto -->
        <div class="reservanto-iframe" data-id={site.integrations.reservantoId}></div>
        <noscript>
          <p>Pro zobrazení rezervačního formuláře je potřeba povolit JavaScript. Objednat se můžete také telefonicky na {site.phones.main.label}.</p>
        </noscript>
      </div>

      <div class="rez__other card" id="jine-objednani">
        <h2 class="rez__other-title">Kdy se objednat telefonicky nebo e-mailem</h2>
        <div class="rez__other-grid">
          <div class="rez__text">
            <p>
              Pro objednání na kontrolu, s jinými problémy, než najdete ve formuláři, nebo pro objednání s
              <strong>PLAZY (MVDr. Pavelková)</strong> či nemocnými <strong>DROBNÝMI SAVCI (MVDr. Škubal)</strong>, prosím využijte
              telefon nebo <strong><a href="/kontakty/#napiste-nam">kontaktní formulář</a></strong> v záložce <strong>„Kontakty“</strong>.
            </p>
            <p>
              V případě, že telefon nezvedáme, máme jak doktor, tak sestřička plné ruce pacienta v ordinaci.<br />
              V neakutních případech nám tedy prosím zašlete <strong><a href={`mailto:${site.email}`}>email</a></strong> s
              telefonním číslem a Vaším požadavkem – zavoláme Vám co nejdříve zpět.
            </p>
            <p><strong>Děkujeme</strong></p>
          </div>
          <ul class="rez__phones">
            <li>
              <span class="rez__phones-label">Objednání, ordinace a pohotovost</span>
              <a class="rez__phones-num" href={site.phones.main.href}><Icon name="phone" size={18} />{site.phones.main.label}</a>
            </li>
            <li>
              <span class="rez__phones-label">E-mail</span>
              <a class="rez__phones-num rez__phones-num--mail" href={`mailto:${site.email}`}><Icon name="mail" size={18} />{site.email}</a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <ContactCards />
</Base>

<script is:inline defer src="https://booking.reservanto.cz/Script/reservanto-iframe.js"></script>
<script is:inline>
  // Odeslání úspěšné rezervace z Reservanta do GTM (převzato z původního webu)
  document.addEventListener('ReservantoBookingSuccess', function (e) {
    var n = e.detail.booking;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'reservationComplete',
      reservationConfirmed: n.confirmed,
      customerId: n.customerId,
      priceWithVat: n.priceWithVat,
      reservationId: n.id,
    });
  });
</script>

<style>
  :global(.page-crumbs) {
    margin: 4px 0 28px;
  }

  .rez {
    padding: 8px 0 117px;
  }

  .rez .row {
    padding-bottom: 0;
  }

  .rez__lead {
    margin-bottom: 10px;
    color: var(--c-text);
    font-family: var(--f-head);
    font-size: 22px;
    line-height: 1.5;
    text-align: center;
  }

  .rez__note {
    margin: 0 auto;
    color: var(--c-text);
    font-family: var(--f-head);
    font-size: 16px;
    text-align: center;
  }

  .rez__note a {
    color: var(--c-link);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .rez__other {
    max-width: 950px;
    margin: 40px auto 0;
    padding: 30px 34px;
  }

  .rez__other-title {
    margin: 0 0 16px;
    padding: 0;
    color: var(--c-heading);
    font-family: var(--f-head);
    font-size: 24px;
    font-weight: 800;
    line-height: 1.3;
  }

  .rez__other-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 30px;
    align-items: start;
  }

  .rez__text {
    font-family: var(--f-head);
    font-size: 16px;
    line-height: 1.75em;
  }

  .rez__phones {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rez__phones li {
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--c-cream);
  }

  .rez__phones-label {
    display: block;
    color: #8a7a6c;
    font-family: var(--f-head);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rez__phones-num {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--c-ink);
    font-family: var(--f-head);
    font-size: 18px;
    font-weight: 800;
    overflow-wrap: anywhere;
  }

  .rez__phones-num--mail {
    font-size: 16px;
  }

  .rez__phones-num :global(svg) {
    flex: none;
    color: var(--c-orange-deep);
  }

  .rez__text a {
    color: var(--c-link);
  }

  .rez__widget {
    max-width: 950px;
    margin: 24px auto 0;
  }

  /* Reservanto vkládá iframe s height:100 %, kontejner proto musí mít pevnou výšku (jinak spadne na 150 px) */
  .rez__widget .reservanto-iframe {
    height: 820px;
    height: min(820px, calc(100svh - 140px));
    min-height: 560px;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(51, 34, 17, 0.08);
  }

  @media (max-width: 767px) {
    .rez {
      padding-bottom: 50px;
    }
    .rez__lead {
      font-size: 19px;
    }
    .rez__text {
      font-size: 15px;
    }
    .rez__note {
      font-size: 15px;
    }
    .rez__other {
      margin-top: 30px;
      padding: 22px 18px;
    }
    .rez__other-title {
      font-size: 20px;
    }
    .rez__other-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    .rez__phones {
      order: -1;
    }
    .rez__phones-num {
      font-size: 17px;
    }
    .rez__widget .reservanto-iframe {
      /* Místo mezi hlavičkou a spodní lištou Zavolat / Objednat se */
      height: calc(100vh - 190px);
      height: calc(100svh - 190px);
      min-height: 520px;
    }
  }
</style>
